rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Private users/{userId}: schemaVersion 1, revision 0, nullable preferredName
    // (up to 80 characters), and server-created createdAt/updatedAt timestamps.
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidProfile(profile) {
      return profile.keys().hasAll([
          'schemaVersion', 'revision', 'preferredName', 'createdAt', 'updatedAt'
        ])
        && profile.keys().hasOnly([
          'schemaVersion', 'revision', 'preferredName', 'createdAt', 'updatedAt'
        ])
        && profile.schemaVersion == 1
        && profile.revision is int && profile.revision == 0
        && (profile.preferredName == null
          || (profile.preferredName is string && profile.preferredName.size() <= 80))
        && profile.createdAt == request.time
        && profile.updatedAt == request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidProfile(request.resource.data);
    }
  }
}
