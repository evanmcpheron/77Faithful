    "@expo/ui": "~57.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "aws-amplify": "^6.20.0",
    "expo": "~57.0.20",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.3",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.4",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.19",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.24.1",
    "@aws-amplify/backend-cli": "^1.9.1",
    "@aws-sdk/client-cognito-identity-provider": "^3.1128.0",
    "@aws-sdk/client-dynamodb": "^3.1128.0",
    "@aws-sdk/client-lambda": "^3.1127.0",
    "@aws-sdk/lib-dynamodb": "^3.1128.0",
    "@babel/generator": "7.29.8",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.13.3",
    "@types/react": "~19.2.2",
    "aws-cdk-lib": "^2.267.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.9.6",
    "test-renderer": "^1.2.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typegen": "expo customize tsconfig.json",
    "typecheck": "npm run typegen && tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "scripture:audit": "node scripts/audit-scripture.js",
    "backend:typecheck": "tsc --noEmit -p amplify/tsconfig.json",
    "backend:test": "node --import tsx --test --test-force-exit amplify/data-invariants/handler.test.ts",
    "backend:verify": "node --import tsx scripts/verify-amplify-backend.js",
    "backend:verify:aws": "node scripts/verify-amplify-data-authorization.mjs",
    "sandbox": "ampx sandbox --identifier auth-foundation --outputs-format json --outputs-version 1.5 --outputs-out-dir .",
    "sandbox:once": "npm run sandbox -- --once",
    "sandbox:delete": "ampx sandbox delete --identifier auth-foundation",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run backend:typecheck && npm run backend:test && npm run backend:verify && npm run test:ci && npm run scripture:audit",
    "export:web": "expo export --platform web"
  },
  "private": true,
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  }
}
