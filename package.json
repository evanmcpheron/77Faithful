{
	"name": "mobile",
	"main": "expo-router/entry",
	"version": "1.0.0",
	"scripts": {
		"dev": "expo start",
		"start": "expo start",
		"android": "expo run:android",
		"ios": "expo run:ios",
		"web": "expo start --web",
		"storybook:start": "EXPO_PUBLIC_STORYBOOK_ENABLED=true expo start --clear",
		"storybook:ios": "EXPO_PUBLIC_STORYBOOK_ENABLED=true expo start --ios --clear",
		"storybook:android": "EXPO_PUBLIC_STORYBOOK_ENABLED=true expo start --android --clear",
		"storybook:generate": "sb-rn-get-stories",
		"lint": "ESLINT_USE_FLAT_CONFIG=false expo lint",
		"lint:fix": "ESLINT_USE_FLAT_CONFIG=false expo lint --fix",
		"format": "prettier . --write",
		"format:check": "prettier . --check",
		"test": "jest",
		"prepare": "node scripts/install-git-hooks.cjs",
		"test:rules": "node tests/firestore-rules.test.cjs",
		"test:journey-setup": "node --test tests/journey-setup.test.cjs",
		"test:journey-start": "npm --prefix functions run build && node --test tests/start-journey.test.cjs"
	},
	"dependencies": {
		"@expo-google-fonts/noto-sans-tc": "^0.4.3",
		"@react-native-async-storage/async-storage": "^2.2.0",
		"@react-native-masked-view/masked-view": "0.3.2",
		"@shopify/flash-list": "2.0.2",
		"axios": "^1.16.0",
		"dayjs": "^1.11.20",
		"expo": "^57.0.21",
		"expo-blur": "~57.0.2",
		"expo-clipboard": "~57.0.1",
		"expo-constants": "~57.0.17",
		"expo-crypto": "~57.0.2",
		"expo-font": "~57.0.3",
		"expo-glass-effect": "~57.0.2",
		"expo-haptics": "~57.0.2",
		"expo-image": "~57.0.4",
		"expo-image-manipulator": "~57.0.16",
		"expo-image-picker": "~57.0.16",
		"expo-linear-gradient": "~57.0.1",
		"expo-linking": "~57.0.9",
		"expo-router": "~57.0.20",
		"expo-secure-store": "~57.0.3",
		"expo-splash-screen": "~57.0.8",
		"expo-status-bar": "~57.0.1",
		"expo-symbols": "~57.0.2",
		"expo-system-ui": "~57.0.3",
		"expo-web-browser": "~57.0.2",
		"firebase": "^12.19.0",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"react-native": "0.86.3",
		"react-native-gesture-handler": "~2.32.0",
		"react-native-keyboard-aware-scroll-view": "^0.9.5",
		"react-native-paper": "^5.15.1",
		"react-native-reanimated": "4.5.1",
		"react-native-safe-area-context": "~5.7.0",
		"react-native-screens": "~4.26.0",
		"react-native-svg": "15.15.4",
		"react-native-web": "^0.21.2",
		"react-native-worklets": "0.10.1",
		"styled-components": "^6.4.0"
	},
	"devDependencies": {
		"@react-native-community/datetimepicker": "9.1.0",
		"@react-native-community/slider": "5.2.0",
		"@storybook/addon-ondevice-actions": "10.3.2",
		"@storybook/addon-ondevice-controls": "10.3.2",
		"@storybook/react-native": "10.3.2",
		"@turndown/library": "^0.1.70",
		"@types/jest": "29.5.14",
		"@types/react": "~19.2.4",
		"eslint": "^9.39.4",
		"eslint-config-expo": "~57.0.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.5",
		"jest": "~29.7.0",
		"prettier": "^3.8.3",
		"prettier-plugin-organize-imports": "^4.3.0",
		"react-native-dotenv": "^3.4.11",
		"react-native-svg-transformer": "^1.5.3",
		"react-test-renderer": "19.2.3",
		"storybook": "10.6.0",
		"ts-jest": "^29.4.9",
		"typescript": "~6.0.3"
	},
	"overrides": {
		"@storybook/react-native-ui": "10.4.7"
	},
	"private": true
}
